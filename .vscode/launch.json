{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "epay（本地 HTTP）",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${workspaceFolder}/cmd/epay",
            "cwd": "${workspaceFolder}",
            "env": {
                "GOTOOLCHAIN": "local",
                "EPAY_ADDR": "127.0.0.1:8080",
                "EPAY_COOKIE_SECURE": "false"
            }
        },
        {
            "name": "当前 Go 包",
            "type": "go",
            "request": "launch",
            "mode": "auto",
            "program": "${fileDirname}",
            "cwd": "${workspaceFolder}",
            "env": {
                "GOTOOLCHAIN": "local"
            }
        }
    ]
}
